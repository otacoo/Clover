<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark-mode variant of the launch theme: the system starting window
         uses this so dark-mode users don't get a white flash on launch. -->
    <style name="Chan.Theme.Launch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>
